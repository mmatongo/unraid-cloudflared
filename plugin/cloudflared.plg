<FILE Name="/usr/local/emhttp/plugins/cloudflared/include/ajax/service_handler.php" Mode="0644">
<INLINE>
<![CDATA[<?php
namespace Cloudflared;

header('Content-Type: application/json');

$docroot = $docroot ?? $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp';
require_once "$docroot/plugins/cloudflared/include/ServiceManager.php";
require_once "$docroot/plugins/cloudflared/include/Config.php";
require_once "$docroot/plugins/cloudflared/include/Logger.php";

try {
    $action = $_POST['action'] ?? '';

    $serviceManager = new ServiceManager();

    switch ($action) {
        case 'apply':
            if (!isset($_POST['config']) || !is_array($_POST['config'])) {
                throw new \Exception('Invalid configuration data');
            }

            $result = $serviceManager->applyConfig($_POST['config']);
            echo json_encode($result);
            break;

        case 'start':
            $result = $serviceManager->start();
            echo json_encode($result);
            break;

        case 'stop':
            $result = $serviceManager->stop();
            echo json_encode($result);
            break;

        case 'restart':
            $result = $serviceManager->restart();
            echo json_encode($result);
            break;

        case 'status':
            $result = [
                'success' => true,
                'running' => $serviceManager->isRunning(),
            ];
            echo json_encode($result);
            break;

        default:
            throw new \Exception('Invalid action specified');
    }

} catch (\Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'message' => $e->getMessage()
    ]);
}
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/cloudflared/include/ajax/update_handler.php" Mode="0644">
<INLINE>
<![CDATA[<?php
namespace Cloudflared;

header('Content-Type: application/json');

$script = '/usr/local/emhttp/plugins/cloudflared/scripts/cf-update.sh';
$settingsFile = '/boot/config/plugins/cloudflared/config/update.cfg';
$dest = '/boot/config/plugins/cloudflared';

function installedVersion() {
    $out = trim((string)shell_exec('/usr/local/sbin/cloudflared --version 2>/dev/null'));
    return preg_match('/version\s+(\S+)/', $out, $m) ? $m[1] : '';
}

function settings($file) {
    $s = ['UPDATE_CHECK' => 'never', 'UPDATE_AUTO' => 'no'];
    if (file_exists($file)) {
        $s = array_merge($s, parse_ini_file($file));
    }
    return $s;
}

function staged($dest) {
    $versions = [];
    foreach (glob("$dest/cloudflared-[0-9]*") as $f) {
        $versions[] = substr(basename($f), strlen('cloudflared-'));
    }
    usort($versions, 'version_compare');
    return $versions;
}

function runScript($script, $args) {
    $cmd = escapeshellarg($script) . ' ' . $args . ' 2>&1';
    exec($cmd, $lines, $rc);
    return [$rc, implode("\n", $lines)];
}

try {
    $action = $_POST['action'] ?? '';
    switch ($action) {
        case 'status':
            echo json_encode(['success' => true, 'installed' => installedVersion(), 'staged' => staged($dest)] + settings($settingsFile));
            break;

        case 'check':
            list($rc, $out) = runScript($script, 'check');
            if ($rc !== 0 || !preg_match('/latest:\s*(\S+)/', $out, $m)) {
                throw new \Exception('Could not reach the release server');
            }
            $latest = $m[1];
            $installed = installedVersion();
            echo json_encode(['success' => true, 'installed' => $installed, 'latest' => $latest,
                'newer' => version_compare($latest, $installed, '>')]);
            break;

        case 'install':
            $version = $_POST['version'] ?? '';
            if (!preg_match('/^[0-9]+(\.[0-9]+)*$/', $version)) {
                throw new \Exception('Invalid version');
            }
            list($rc, $out) = runScript($script, 'stage ' . escapeshellarg($version));
            if ($rc !== 0) {
                throw new \Exception("Download or verification failed:\n$out");
            }
            list($rc, $out2) = runScript($script, 'apply ' . escapeshellarg($version));
            echo json_encode(['success' => $rc === 0, 'message' => $out . "\n" . $out2, 'installed' => installedVersion()]);
            break;

        case 'save':
            $check = $_POST['UPDATE_CHECK'] ?? 'never';
            $auto = $_POST['UPDATE_AUTO'] ?? 'no';
            if (!in_array($check, ['never', 'boot', 'daily', 'weekly'], true) || !in_array($auto, ['no', 'yes'], true)) {
                throw new \Exception('Invalid settings');
            }
            file_put_contents($settingsFile, "UPDATE_CHECK=\"$check\"\nUPDATE_AUTO=\"$auto\"\n");
            runScript($script, 'cron');
            echo json_encode(['success' => true]);
            break;

        default:
            throw new \Exception('Invalid action specified');
    }
} catch (\Exception $e) {
    http_response_code(500);
    echo json_encode(['success' => false, 'message' => $e->getMessage()]);
}
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/cloudflared/include/install_functions.sh" Mode="0755">
<INLINE>
<![CDATA[#!/bin/bash

cloudflared_log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    logger -t cloudflared-install "$1"
}

cloudflared_create_default_config() {
    local config_file="/boot/config/plugins/cloudflared/config/cloudflared.cfg"

    if [ ! -f "$config_file" ]; then
        cloudflared_log "Creating default configuration..."
        mkdir -p "$(dirname "$config_file")"
        cat > "$config_file" <<EOL
# Cloudflared configuration
SERVICE="disabled"
TUNNEL_TOKEN=""
TUNNEL_RETRIES="5"
TUNNEL_REGION=""
TUNNEL_TRANSPORT_PROTOCOL="auto"
TUNNEL_EDGE_BIND_ADDRESS=""
TUNNEL_EDGE_IP_VERSION="auto"
TUNNEL_GRACE_PERIOD="30s"
TUNNEL_ORIGIN_CERT=""
TUNNEL_METRICS="0.0.0.0:46495"
TUNNEL_LOGLEVEL="info"
TUNNEL_ORIGIN_CERT=""
EOL
    fi
}

cloudflared_setup_logging() {
    local log_dir="/var/log/cloudflared"
    mkdir -p "$log_dir"
    chmod 755 "$log_dir"

    cat > "/etc/logrotate.d/cloudflared" <<EOL
/var/log/cloudflared/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    postrotate
        /usr/local/emhttp/plugins/cloudflared/scripts/restart.sh restart >/dev/null 2>&1 || true
    create 644 nobody users
}
EOL
}

cloudflared_install_completion() {
    if command -v cloudflared >/dev/null 2>&1; then
        cloudflared_log "Installing shell completion..."
        cloudflared completion bash > /etc/bash_completion.d/cloudflared
        chmod 644 /etc/bash_completion.d/cloudflared
    fi
}
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/cloudflared/scripts/cf-update.sh" Mode="0755">
<INLINE>
<![CDATA[#!/bin/bash
# Local update of the cloudflared binary (no package to rebuild).
#   cf-update.sh check             show installed / latest release (nothing is changed)
#   cf-update.sh stage [version]   download, verify and store as $DEST/cloudflared-<version> (not activated)
#   cf-update.sh apply <version>   activate a staged version (copy to /usr/local/sbin, restart the service)
#   cf-update.sh auto              what the scheduled / boot check runs: stage a newer release, notify, apply it if UPDATE_AUTO=yes
#   cf-update.sh cron              (re)write the cron entry from the update settings
# Settings (UPDATE_CHECK=never|boot|daily|weekly, UPDATE_AUTO=no|yes): $DEST/config/update.cfg
# Verification: the SHA256 of the binary must match both the one in the release notes
# and the digest computed by GitHub, and the binary must run (--version).
DEST=${CF_DEST:-/boot/config/plugins/cloudflared}
REPO=cloudflare/cloudflared
ASSET=cloudflared-linux-amd64
API=https://api.github.com/repos/$REPO/releases
BIN=${CF_BIN:-/usr/local/sbin/cloudflared}
SETTINGS=$DEST/config/update.cfg
CRONFILE=$DEST/cloudflared-update.cron
SELF=$(readlink -f "$0")
UPDATE_CHECK=never; UPDATE_AUTO=no
[ -f "$SETTINGS" ] && . "$SETTINGS"
notify() { /usr/local/emhttp/webGui/scripts/notify -e "Cloudflared" -s "$1" -d "$2" -i "${3:-normal}" 2>/dev/null; }
log() { echo "$(date '+%F %T') $*"; logger -t cloudflared-update "$*" 2>/dev/null; }

release_json() { if [ -n "$1" ]; then curl -fsS -m 30 "$API/tags/$1"; else curl -fsS -m 30 "$API/latest"; fi; }

case "$1" in
check)
  cur=$("$BIN" --version 2>/dev/null | awk '{print $3}')
  last=$(release_json | python3 -c 'import sys,json;print(json.load(sys.stdin)["tag_name"])')
  echo "installed: ${cur:-unknown}  latest: $last"
  ;;
stage)
  json=$(release_json "$2") || { log "ERROR: release not found"; exit 1; }
  read -r tag digest notes < <(printf '%s' "$json" | python3 -c '
import sys,json,re
r=json.load(sys.stdin); a=[x for x in r["assets"] if x["name"]=="'$ASSET'"][0]
m=re.search(r"'$ASSET':\s*([0-9a-f]{64})", r.get("body") or "")
print(r["tag_name"], (a.get("digest") or "").replace("sha256:",""), m.group(1) if m else "")')
  [ -n "$tag" ] && [ -n "$digest" ] && [ "$digest" = "$notes" ] || { log "ERROR: checksums missing or different (GitHub digest=$digest, release notes=$notes)"; exit 1; }
  mkdir -p "$DEST"; tmp=$(mktemp)
  curl -fsSL -m 300 -o "$tmp" "https://github.com/$REPO/releases/download/$tag/$ASSET" || { rm -f "$tmp"; log "ERROR: download failed"; exit 1; }
  got=$(sha256sum "$tmp" | awk '{print $1}')
  [ "$got" = "$digest" ] || { rm -f "$tmp"; log "ERROR: file checksum ($got) differs from $digest"; exit 1; }
  chmod +x "$tmp"; "$tmp" --version >/dev/null 2>&1 || { rm -f "$tmp"; log "ERROR: the binary does not run"; exit 1; }
  mv "$tmp" "$DEST/cloudflared-$tag"
  grep -v " cloudflared-$tag\$" "$DEST/sha256sums" 2>/dev/null > "$DEST/sha256sums.tmp"; echo "$got  cloudflared-$tag" >> "$DEST/sha256sums.tmp"; mv "$DEST/sha256sums.tmp" "$DEST/sha256sums"
  log "OK: $tag staged ($got)"
  ;;
apply)
  f="$DEST/cloudflared-$2"; [ -x "$f" ] || { log "ERROR: $f not found (run stage first)"; exit 1; }
  exp=$(awk -v f="cloudflared-$2" '$2==f {print $1}' "$DEST/sha256sums" 2>/dev/null)
  [ -z "$exp" ] || [ "$exp" = "$(sha256sum "$f" | awk '{print $1}')" ] || { log "ERROR: staged file checksum mismatch"; exit 1; }
  cp "$f" "$BIN.new" && mv "$BIN.new" "$BIN" && log "binary $2 activated"
  [ "${CF_NORESTART:-0}" = 1 ] || /usr/local/emhttp/plugins/cloudflared/scripts/restart.sh restart
  ;;
auto)
  [ "$UPDATE_CHECK" = never ] && exit 0
  cur=$("$BIN" --version 2>/dev/null | awk '{print $3}')
  last=$(release_json | python3 -c 'import sys,json;print(json.load(sys.stdin)["tag_name"])') || { log "auto: release check failed"; exit 1; }
  [ -n "$last" ] && [ "$last" != "$cur" ] && [ "$(printf '%s\n%s\n' "$cur" "$last" | sort -V | tail -1)" = "$last" ] || { log "auto: up to date ($cur)"; exit 0; }
  "$SELF" stage "$last" || { notify "Cloudflared: update $last failed" "The checksum verification or the download failed, see the plugin log." alert; exit 1; }
  if [ "$UPDATE_AUTO" = yes ]; then
    "$SELF" apply "$last" && notify "Cloudflared updated to $last" "Previous version: $cur" || notify "Cloudflared: applying $last failed" "Still on $cur" alert
  else
    notify "Cloudflared $last available" "Downloaded and verified. Install it from Settings > Cloudflared."
  fi
  ;;
cron)
  case "$UPDATE_CHECK" in
    daily)  echo "17 4 * * * $SELF auto >/dev/null 2>&1" > "$CRONFILE" ;;
    weekly) echo "17 4 * * 2 $SELF auto >/dev/null 2>&1" > "$CRONFILE" ;;
    *)      rm -f "$CRONFILE" ;;
  esac
  /usr/local/sbin/update_cron
  ;;
*) sed -n 2,9p "$0"; exit 1 ;;
esac
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/cloudflared/scripts/init-logs.sh" Mode="0755">
<INLINE>
<![CDATA[#!/bin/bash

LOG_DIR="/var/log/cloudflared"
LOGFILE="$LOG_DIR/cloudflared.log"

mkdir -p "$LOG_DIR"

if [ ! -f "$LOGFILE" ]; then
    touch "$LOGFILE"
    echo "$(date '+%Y-%m-%d %H:%M:%S') Cloudflared log initialized." > "$LOGFILE"
fi

chmod 644 "$LOGFILE"
chown nobody:users "$LOGFILE"
]]>
